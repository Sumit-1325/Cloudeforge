PORT=5000
# Placeholder only — never commit real credentials to this file.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<db>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cloudforge
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Optional: Docker Hub username. Deployed apps run as containers on this
# machine from the locally built image, so no registry is needed. If set,
# images are tagged <DOCKER_REGISTRY_USERNAME>/<image>:<tag> and also pushed
# to Docker Hub (run `docker login` once first). Leave empty to skip pushing.
DOCKER_REGISTRY_USERNAME=

# Optional: host used in deployed app URLs (http://<PUBLIC_HOST>:<port>).
# Defaults to localhost; set it to the server's public IP or domain on a VPS.
PUBLIC_HOST=localhost
